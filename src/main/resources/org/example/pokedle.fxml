<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.PokedleController"
styleClass="pokedle-page"
stylesheets="@../../css/pokedle.css">

    <top>
        <HBox alignment="CENTER" spacing="28" styleClass="navigation-bar">
            <Hyperlink text="Pokédex" styleClass="navigation-link"
                       onMouseClicked="#switchToPokedex"/>
            <Hyperlink text="Comparar Pokémon" styleClass="navigation-link"
                       onMouseClicked="#switchToCompara"/>
            <Hyperlink text="Pokedle" styleClass="navigation-link"
                       onMouseClicked="#switchToPokedle"/>
        </HBox>
    </top>

    <!-- CONTEÚDO DO JOGO -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              maxWidth="900"
              styleClass="pokedle-content">

            <!-- TÍTULO -->
            <Label text="POKEDLE" styleClass="game-title"/>

            <Label text="Adivinhe o Pokémon secreto!" styleClass="game-subtitle"/>

            <!-- TENTATIVAS -->
            <Label fx:id="tentativasLabel" text="Tentativas restantes: 8" styleClass="attempts-label"/>

            <!-- CAMPO DE PALPITE -->
            <HBox alignment="CENTER"
                  spacing="10"
                  maxWidth="600">

                <ComboBox fx:id="campoPalpite"
                          editable="true"
                          promptText="Digite o nome de um Pokémon..."
                          prefHeight="42"
                          maxWidth="Infinity"
                          styleClass="guess-combo"
                          HBox.hgrow="ALWAYS"/>

                <Button fx:id="botaoTentar"
                        text="Tentar"
                        onAction="#enviarPalpite"
                        prefHeight="42"
                        styleClass="try-button"/>

            </HBox>

            <!-- MENSAGENS -->
            <Label fx:id="mensagemLabel" text="Digite seu primeiro palpite!"
                   wrapText="true" styleClass="game-message"/>

            <!-- NOVA PARTIDA -->
            <Button text="Nova Partida"
                    onAction="#novoJogo"
                    styleClass="new-game-button"/>

            <!-- HISTÓRICO -->
            <Label text="Histórico de tentativas" styleClass="history-title"/>

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                    styleClass="history-scroll">

                <VBox fx:id="historicoTentativas"
                      spacing="12"
                  styleClass="history-list"/>

            </ScrollPane>

        </VBox>
    </center>

</BorderPane>