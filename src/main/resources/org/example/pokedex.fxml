<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.PokedexController"
            stylesheets="@../../css/pokedex.css"
            style="-fx-background-color: #f1f5f9;">
    <top>
        <HBox alignment="CENTER" spacing="28" styleClass="navigation-bar">
            <Hyperlink text="Pokédex" styleClass="navigation-link"
                       onMouseClicked="#switchToPokedex"/>
            <Hyperlink text="Comparar Pokémon" styleClass="navigation-link"
                       onMouseClicked="#switchToCompara"/>
            <Hyperlink text="Pokedle" styleClass="navigation-link"
                       onMouseClicked="#switchToPokedle"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 24;">
            <Label text="Pokédex Nacional" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
            <Label text="Explore os 151 Pokémon da primeira geração."
                   style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>

            <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="campoBusca" promptText="Buscar por nome ou número..."
                               onAction="#buscarPokemon" HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 8; -fx-padding: 10;"/>
                    <Button text="Buscar" onAction="#buscarPokemon" styleClass="primary-button"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Ordenar:" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="ordenacaoCombo" prefWidth="190" onAction="#aplicarFiltros"/>
                    <Label text="Tipo:" style="-fx-text-fill: #475569; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="tipoCombo" prefWidth="150" onAction="#aplicarFiltros"/>
                    <ComboBox fx:id="quantidadeTiposCombo" prefWidth="160" onAction="#aplicarFiltros"/>
                    <Button fx:id="filtroFavoritosButton" text="Favoritos" onAction="#alternarFiltroFavoritos"
                            styleClass="favorite-filter-button">
                        <graphic>
                            <ImageView fx:id="filtroFavoritosIcone" fitWidth="20" fitHeight="20"
                                       preserveRatio="true" smooth="false" styleClass="pixel-art"/>
                        </graphic>
                        <tooltip>
                            <Tooltip text="Mostrar somente Pokémon favoritos"/>
                        </tooltip>
                    </Button>
                    <Button text="Limpar filtros" onAction="#limparFiltros" styleClass="secondary-button"/>
                </HBox>
            </VBox>

            <Label fx:id="resultadoLabel" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <GridPane fx:id="gradePokemons" hgap="14" vgap="14"
                              style="-fx-padding: 4 4 18 4;"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
